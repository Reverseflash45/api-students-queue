APP_PORT=3000
APP_NAME=Praktikum Backend Lanjut - Pertemuan 11

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable
DB_MAX_CONNS=10

LOG_LEVEL=info

# ==============================================================
# KEAMANAN
# ==============================================================
# Wajib diisi, minimal 32 karakter acak. Aplikasi sengaja menolak
# menyala bila nilainya kosong atau terlalu pendek, lebih baik gagal
# seketika daripada berjalan dengan token yang mudah dipalsukan.
#
# Buat nilai baru dengan:
#   PowerShell : -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
#   Git Bash   : openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=praktikum-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

ALLOWED_ORIGINS=http://localhost:5173

# MongoDB (pertemuan 10). Untuk Atlas, isi dengan connection string mongodb+srv://
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=praktikum_backend
MONGO_MAX_POOL=20

# Redis dan worker (pertemuan 11). Di Windows, Redis dijalankan lewat Memurai.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=5
RELAY_INTERVAL_MS=1000
RELAY_BATCH=100
MAILER_DELAY_MS=1500
MAILER_FAIL_EVERY=0
